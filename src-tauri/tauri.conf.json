{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Desk",
  "version": "0.1.0",
  "identifier": "dev.claudedesk.app",
  "build": {
    "beforeDevCommand": "npm run sidecar:build && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run sidecar:build && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Desk",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../sidecar/dist/": "sidecar/dist/",
      "../sidecar/node_modules/": "sidecar/node_modules/",
      "../sidecar/package.json": "sidecar/package.json"
    }
  }
}
