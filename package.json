{
  "name": "slop-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sidecar:install": "npm --prefix sidecar install",
    "sidecar:build": "npm --prefix sidecar run build",
    "dev": "vite",
    "dev:browser": "npm run sidecar:build && concurrently -k -n bridge,vite \"node scripts/dev-bridge.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "test": "npm --prefix sidecar test",
    "test:ui": "npm run sidecar:build && node --test --test-concurrency=1 tests/ui/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/dompurify": "^3.0.5",
    "concurrently": "^10.0.6",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "ws": "^8.22.0"
  },
  "description": "A desktop app for running coding agents on your projects, with a live task board, questions and a process monitor",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=24"
  }
}
